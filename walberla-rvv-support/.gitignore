# Rules for walberla-rvv-support/ only; paths are relative to this folder.
# Repo-wide rules (.idea, __pycache__, venvs) are in the root .gitignore.

# Cache written by the perf probe in scripts/legacy-vla/
/scripts/**/.perfcache/

# Archive left over from the old zip-based push.to.sh
my-e4-ws.zip

# Local builds (e.g. build/presentation4-x86/: waLBerla on x86 for the presentation4
# correctness checks). push.to.sh excludes this folder too, so it never reaches the board.
/build/
