+//**********************************************************************************************************************
+/*!\brief Skipping the given number of elements, at a position that is aligned for values of type \a V.
+//
+// \param elements The number of elements (bytes) of the values of type \a V.
+// \return Position of the values, aligned for \a V.
+//
+// Reads data written with GenericSendBuffer::forwardAligned, with the same \a V and number of elements: skips
+// sizeof(V) elements more than \a elements and returns the first position in that range that is aligned for
+// \a V.
+*/
+template< typename T >  // Element type
+template< typename V >  // Type of the values read at the returned position
+T * GenericRecvBuffer<T>::skipAligned( size_t elements )
+{
+   static_assert( sizeof(T) == 1, "skipAligned needs a buffer of bytes" );
+
+   std::size_t space = elements + sizeof(V);
+   void * ptr = skip( space );
+   ptr = std::align( alignof(V), elements, ptr, space );
+   WALBERLA_ASSERT_NOT_NULLPTR( ptr );
+
+   return static_cast< T * >( ptr );
+}
