+//**********************************************************************************************************************
+/*!\brief Forward the given number of elements, at a position that is aligned for values of type \a V.
+//
+// \param elements The number of elements (bytes) needed for the values of type \a V.
+// \return Position of the values, aligned for \a V.
+//
+// The send buffer is char-aligned: whatever was written before leaves the current position at an arbitrary
+// byte offset. Code that writes the values through a pointer to \a V, like the generated packing kernels, needs
+// them aligned: misaligned accesses are undefined behavior, and some hardware faults on them (e.g. vector stores
+// on RISC-V). This function forwards sizeof(V) elements more than \a elements and returns the first position in
+// that range that is aligned for \a V. The receiver reads the data with GenericRecvBuffer::skipAligned, with the
+// same \a V and number of elements. Both find the same position: both buffers are allocated with new[], which
+// aligns them for every fundamental type, and the data is at the same offset in both.
+*/
+template< typename T    // Element type
+        , typename G >  // Growth policy
+template< typename V >  // Type of the values written at the returned position
+T * GenericSendBuffer<T,G>::forwardAligned( uint_t elements )
+{
+   static_assert( sizeof(T) == 1, "forwardAligned needs a buffer of bytes" );
+
+   std::size_t space = elements + sizeof(V);
+   void * ptr = forward( space );
+   ptr = std::align( alignof(V), elements, ptr, space );
+   WALBERLA_ASSERT_NOT_NULLPTR( ptr );
+
+   return static_cast< T * >( ptr );
+}
 
