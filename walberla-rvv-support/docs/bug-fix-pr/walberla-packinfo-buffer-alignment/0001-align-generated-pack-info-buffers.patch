 #include <optional>
@@ -343,6 +344,41 @@ void bufferOverwriteTest()
 }
 
 
+/// forwardAligned/skipAligned: whatever was written before, the data of type V is aligned for V, the receiver
+/// finds it at the same place, and the data after it is read correctly
+template< typename V >
+void bufferAlignedTest()
+{
+   const uint_t n = 5;
+   for( uint_t headerBytes = 0; headerBytes < 2 * sizeof(V); ++headerBytes )
+   {
+      SendBuffer sb;
+      for( uint_t i = 0; i < headerBytes; ++i )
+         sb << uint8_c( i );
+      V * out = reinterpret_cast< V * >( sb.forwardAligned< V >( n * sizeof(V) ) );
+      WALBERLA_CHECK_EQUAL( reinterpret_cast< std::uintptr_t >( out ) % alignof(V), 0 )
+      for( uint_t i = 0; i < n; ++i )
+         out[i] = V( i + 1 );
+      sb << uint8_c( 42 );
+
+      RecvBuffer rb( sb );
+      for( uint_t i = 0; i < headerBytes; ++i )
+      {
+         uint8_t header;
+         rb >> header;
+         WALBERLA_CHECK_EQUAL( header, uint8_c( i ) )
+      }
+      const V * in = reinterpret_cast< const V * >( rb.skipAligned< V >( n * sizeof(V) ) );
+      WALBERLA_CHECK_EQUAL( reinterpret_cast< std::uintptr_t >( in ) % alignof(V), 0 )
+      for( uint_t i = 0; i < n; ++i )
+         WALBERLA_CHECK_FLOAT_EQUAL( in[i], V( i + 1 ) )
+      uint8_t tail;
+      rb >> tail;
+      WALBERLA_CHECK_EQUAL( tail, uint8_c( 42 ) )
+   }
+}
+
+
 int main()
 {
    debug::enterTestMode();
@@ -359,6 +395,9 @@ int main()
 
    bufferOverwriteTest();
 
+   bufferAlignedTest< float >();
+   bufferAlignedTest< double >();
+
    return 0;
 }
 
