# =============================================================================
#  docs/presentation3: only the sources are tracked (slides.tex, figures/*.tex,
#  build.sh, this file). ./build.sh writes everything else into build/.
# =============================================================================

# ---- Build output: PDF, logs, rendered PNGs, latexmk state --------------------
build/

# ---- Output of running pdflatex/latexmk by hand in this folder ----------------
#   Only the root: a PDF or PNG placed in figures/ on purpose stays visible.
/slides.pdf
/*.pdf
/*.png
/*.dvi
/*.ps
/*.xdv

# ---- LaTeX auxiliary files (anywhere below this folder) -----------------------
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.lol
*.fls
*.fdb_latexmk
*.synctex.gz
*.synctex(busy)
*.synctex
missfont.log

# ---- beamer -----------------------------------------------------------------
*.nav
*.snm
*.vrb

# ---- Bibliography and index (not used now; harmless if added later) ----------
*.bbl
*.bcf
*.blg
*.run.xml
*.idx
*.ilg
*.ind

# ---- TikZ/pgfplots externalisation (if it is ever switched on) ---------------
*.auxlock
*.figlist
*.makefile
*.dpth
*.md5
*-figure[0-9]*.pdf

# ---- Editors and operating systems --------------------------------------------
*~
*.bak
*.swp
.*.swp
\#*\#
.#*
.DS_Store
Thumbs.db
.vscode/
.idea/
